{
  "$schema": "https://ragbaz.cc/schemas/ragbaz.component.schema.json",
  "schemaVersion": "0.1.0",
  "identity": {
    "id": "ragbaz.weftmark",
    "name": "RAGBAZ WeftMark",
    "version": "0.0.1",
    "repoPath": "WeftMark",
    "owner": "ragbaz",
    "lifecycle": "prototype"
  },
  "commercial": {
    "packageTags": [
      "agent-coordination",
      "software-provenance",
      "review-evidence"
    ],
    "personas": [
      "solo-developer",
      "small-engineering-team",
      "agent-team",
      "platform-owner"
    ],
    "supportTier": "none",
    "salesStatus": "internal",
    "pricingTags": []
  },
  "capabilities": {
    "provides": [
      {
        "id": "ops.weftmark.design",
        "label": "WeftMark product and implementation design",
        "version": "0",
        "supportTier": "prototype",
        "description": "Prototype runtime and repository-grounded architecture for local Change Sets, semantic claims, Git lineage, evidence, review, handoff, CLI/status, and read-only board/mobile projections."
      }
    ]
  },
  "provides": {
    "artifacts": [
      {
        "name": "weftmark-rev0-html",
        "mediaType": "text/html",
        "digestRequired": true,
        "signatureRequired": false
      },
      {
        "name": "weftmark-rev0-pdf",
        "mediaType": "application/pdf",
        "digestRequired": true,
        "signatureRequired": false
      },
      {
        "name": "weftmark-logo-svg",
        "mediaType": "image/svg+xml",
        "digestRequired": true,
        "signatureRequired": false
      }
    ],
    "adminSurfaces": [
      {
        "name": "task-plan",
        "description": "YAML-compatible implementation task graph under tasks/.",
        "capabilities": [
          "ops.weftmark.design"
        ]
      }
    ]
  },
  "security": {
    "authMethods": [],
    "tokenScopes": [],
    "tenantBoundary": "none",
    "dataClasses": [
      "public"
    ],
    "secretAccess": "none",
    "revocation": "No remote mutation surface exists in the prototype. The HTTP read surface is loopback-only; its optional local bearer token is replaced by restarting with a different token file.",
    "auditEvents": []
  },
  "health": {
    "checks": [
      {
        "name": "task-plan-validation",
        "type": "command",
        "target": "python3 scripts/validate_tasks.py",
        "intervalSeconds": 300,
        "timeoutSeconds": 20,
        "required": true
      }
    ]
  },
  "compatibility": {
    "contracts": [
      {
        "name": "weft-task-v0",
        "version": "0.1.0",
        "test": "python3 scripts/validate_tasks.py"
      },
      {
        "name": "docs-build-v0",
        "version": "0.1.0",
        "test": "python3 scripts/build_pdf.py"
      }
    ]
  },
  "docs": {
    "readme": "README.md",
    "architecture": "docs/weftmark.mdx"
  },
  "metadata": {
    "origin": "RAGBAZ Frog evolution",
    "sourceSnapshot": "2026-08-11",
    "runtimeImplemented": true
  }
}
